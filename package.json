{
  "name": "vesper-survival",
  "version": "2.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node scripts/smoke.mjs",
    "start": "node scripts/serve.mjs --open",
    "format": "prettier --write src tests scripts index.html package.json vite.config.js",
    "test:waves": "node scripts/waves-check.mjs",
    "test:mobile": "node scripts/touch-native-check.mjs",
    "test:feel": "node scripts/feel-check.mjs",
    "test:release": "node scripts/release-check.mjs",
    "test:online": "node scripts/online-check.mjs",
    "test:menu": "node scripts/menu-check.mjs",
    "test:visual": "node scripts/visual-check.mjs",
    "test:upgrade": "node scripts/upgrade-check.mjs",
    "test:zombies": "node scripts/zombie-check.mjs",
    "test:abyss": "node scripts/abyss-check.mjs",
    "test:remaster": "node scripts/remaster-check.mjs",
    "test:blood": "node scripts/blood-check.mjs"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "prettier": "^3.9.6",
    "vite": "8.2.2"
  }
}
